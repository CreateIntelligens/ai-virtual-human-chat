# ===========================================
# AI Virtual Human 項目忽略文件
# ===========================================

# ===========================================
# 配置文件 (敏感信息)
# ===========================================

# 環境配置文件
.env
.env.local
.env.production

# CosyVoice 聲音配置 (用戶自定義)
cosyvoice-service/config/voices.local.json

# 人物配置文件 (用戶自定義)
web_demo/static/avatars/avatars.json

# ===========================================
# 大型文件和模型
# ===========================================

# 人物資料夾 (包含大型媒體文件)
web_demo/static/avatars/*/
!web_demo/static/avatars/avatars.sample.json

# CosyVoice 模型文件 (保留目錄結構，忽略模型內容)
cosyvoice-service/models/*
!cosyvoice-service/models/.gitkeep
!cosyvoice-service/models/README.md

# 音頻樣本文件
cosyvoice-service/config/audio_samples/*.mp3
cosyvoice-service/config/audio_samples/*.wav
!cosyvoice-service/config/audio_samples/README.md

# IndexTTS 模型文件 (自動下載，不需要版本控制)
indextts-service/checkpoints/*
!indextts-service/checkpoints/.gitkeep
!indextts-service/checkpoints/README.md

# IndexTTS 輸出文件
indextts-service/outputs/
indextts-service/temp_prompt_*.wav

# IndexTTS 日誌文件
indextts-service/logs/*.log
!indextts-service/logs/.gitkeep

# IndexTTS 音頻樣本文件 (保留配置文件結構)
indextts-service/assets/voices/*/
indextts-service/assets/voices.json
!indextts-service/assets/voices.sample.json
!indextts-service/assets/README.md

# SenseVoice 模型文件 (保留目錄結構，忽略模型內容)
sensevoice-service/models/*
!sensevoice-service/models/.gitkeep
!sensevoice-service/models/README.md

# ===========================================
# 測試和臨時文件
# ===========================================

# 測試文件
test_*.py
*_test.py
test_*.wav
test_*.mp3

# 備份文件
*.backup
*.bak
*.orig
*~

# 臨時文件
*.tmp
*.temp

# 依賴鎖定文件
*.lock
package-lock.json
yarn.lock
poetry.lock
Pipfile.lock
composer.lock
Gemfile.lock

