# AI Virtual Human 環境配置範例
# 複製此文件為 .env 並根據您的環境修改配置

# ===========================================
# TTS 引擎配置
# ===========================================

# 預設 TTS 引擎 (edge_tts 或 cosyvoice)
TTS_DEFAULT_PROVIDER=edge_tts

# 啟用的 TTS 引擎列表 (用逗號分隔)
TTS_ENABLED_PROVIDERS=edge_tts,cosyvoice

# ===========================================
# EdgeTTS 配置
# ===========================================

# 是否啟用 EdgeTTS
EDGE_TTS_ENABLED=true

# ===========================================
# CosyVoice 配置
# ===========================================

# 是否啟用 CosyVoice
COSYVOICE_ENABLED=true

# CosyVoice API 服務地址
COSYVOICE_API_URL=http://cosyvoice-service:50001

# CosyVoice API 超時時間（秒）
COSYVOICE_API_TIMEOUT=180

# CosyVoice API 重試次數
COSYVOICE_RETRY_ATTEMPTS=3

# ===========================================
# LLM 配置
# ===========================================

# LLM 服務提供商 (groq 或 gemini)
LLM_PROVIDER=groq

# Groq 配置
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-70b-versatile

# Gemini 配置
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-pro

# ===========================================
# 服務配置
# ===========================================

# Web 服務端口
WEB_PORT=8888

# CosyVoice 服務端口
COSYVOICE_PORT=50001

# ===========================================
# Docker 配置
# ===========================================

# CosyVoice 模型路徑（主機路徑）
COSYVOICE_MODEL_PATH=./cosyvoice_models/trained_models20250801

# 是否啟用 GPU 支援（需要 NVIDIA Docker）
ENABLE_GPU=false

# ===========================================
# 調試配置
# ===========================================

# 日誌級別 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# 是否啟用詳細日誌
VERBOSE_LOGGING=false
